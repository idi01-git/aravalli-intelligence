# Aravalli Intelligence — Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git.

# ── AI Report Generation ─────────────────────────────────────────────────────
# Primary: GPT OSS 120B (Reasoning) via Together AI (or any OpenAI-compatible API)
PRIMARY_LLM_API_KEY=paste_your_together_ai_key_here

# Fallback: Llama 3.3 70B via Together AI (or same provider as primary)
FALLBACK_LLM_API_KEY=paste_your_fallback_key_here

# ── Optional: Google Earth Engine ───────────────────────────────────────────
# Only needed if running in 'gee_live' data mode.
# GEE_PROJECT=hackathon-iit-bhu
